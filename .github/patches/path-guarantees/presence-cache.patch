 from collections.abc import Iterable, MutableSequence
+from functools import lru_cache
 
 from gridsolver.abstract_grids.gridsize_container import GridSizeContainer
 from gridsolver.rules.rules import Guarantee, IdxType, InvalidGrid, Rule, RuleAlwaysSatisfied
 
 
+@lru_cache(maxsize=256)
+def _cached_value_presence_guarantees(
+    rows: int,
+    cols: int,
+    max_elem: int,
+    cells: tuple[int, ...],
+) -> tuple[Guarantee, ...]:
+    cell_set = frozenset(cells)
+    return tuple(
+        Guarantee(value, cell_set, rows, cols)
+        for value in range(1, max_elem + 1)
+    )
+
+
+def value_presence_guarantees(
+    rows: int,
+    cols: int,
+    max_elem: int,
+    cells: Iterable[int],
+) -> tuple[Guarantee, ...]:
+    """Return cached immutable guarantees requiring every domain value."""
+    return _cached_value_presence_guarantees(
+        rows,
+        cols,
+        max_elem,
+        tuple(sorted(cells)),
+    )
+
+
